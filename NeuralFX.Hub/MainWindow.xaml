<Window x:Class="NeuralFX.Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuralFX Hub · Cities: Skylines 1" Width="1000" Height="700" MinWidth="620" MinHeight="400"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="#555555" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0" Margin="0,0,4,0">
                            <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2D2D30" />
                                <Setter Property="Foreground" Value="#4EC9B0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- ComboBox Dark High-Contrast Styles -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E42" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#007ACC" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="Background" Value="#252526" />
            <Setter Property="BorderBrush" Value="#4A4A52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="#252526" BorderBrush="#4A4A52" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#CCCCCC" Data="M 0 0 L 4 4 L 8 0 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="Background" Value="#2D2D30" />
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,26,6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F1F1F1" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#252526" BorderBrush="#4A4A52" BorderThickness="1" CornerRadius="4" Margin="0,2,0,4">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera Principal con Semáforo de Estado -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Border x:Name="PillGameStatus" DockPanel.Dock="Right" Background="#333337" CornerRadius="6" Padding="16,8" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtGameStatus" Text="VERIFICANDO..." FontWeight="Bold" FontSize="14" Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NEURALFX SUITE · CITIES: SKYLINES" FontWeight="Bold" FontSize="20" Foreground="{StaticResource Success}" />
                    <TextBlock Text="Escalado Neural y Reconstrucción Temporal para DirectX 11" Foreground="{StaticResource TextDim}" Margin="0,3,0,0" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barra de Notificación / Operación en Curso -->
        <Border Grid.Row="1" x:Name="OperationNotice" Background="#1C3445" BorderBrush="#497D9C" BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
                <Button Content="Ver registro" Click="BtnShowLogs_Click" DockPanel.Dock="Right" Background="#45454B" Margin="12,0,0,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock x:Name="TxtOperationTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtOperationDetail" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <ProgressBar x:Name="OperationProgress" IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pestañas Principales -->
        <TabControl x:Name="MainTabs" SelectedIndex="0" Grid.Row="2" Background="#2D2D30" BorderBrush="{StaticResource CardBorder}" Padding="14">

            <!-- PESTAÑA 1: PIPELINE E INSTALACIÓN -->
            <TabItem Header="Inicio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Estado de la ciudad" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="TxtSessionSummary" Text="Sin sesión activa" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                                <TextBlock x:Name="TxtSessionHint" Text="Abre Cities: Skylines para recibir métricas." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,10" />
                                <TextBlock x:Name="TxtTelemetry" Text="Esperando conexión MMF del mod in-game..." FontSize="13" LineHeight="22" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#E0E0E0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Controles In-Game Rápidos" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,8" />
                        <WrapPanel x:Name="TelemetryCommands" IsEnabled="False" Margin="0,0,0,16">
                            <Button Content="Abrir/Cerrar Panel In-Game (Ctrl+Alt+N)" Tag="TogglePanel" Click="BtnTelemetryCommand_Click" Margin="0,0,8,6" />
                            <Button Content="Activar NeuralFX" Tag="EnablePipeline" Click="BtnTelemetryCommand_Click" Margin="0,0,8,6" /><Button Content="Desactivar NeuralFX" Tag="DisablePipeline" Click="BtnTelemetryCommand_Click" Margin="0,0,8,6" /><Button Content="Reaplicar buffers experimentales" Tag="ReapplyBuffers" Click="BtnTelemetryCommand_Click" Margin="0,0,8,6" />
                            <Button Content="Reset de Historial Temporal" Tag="ResetHistory" Click="BtnTelemetryCommand_Click" Margin="0,0,8,6" />
                        </WrapPanel>

                        <TextBlock Text="Integridad de Archivos" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                        <Border Style="{StaticResource Card}">
                            <TextBlock x:Name="TxtIntegrity" Text="Comprobando archivos..." TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource TextDim}" />
                        </Border>

                        <DockPanel Margin="0,6,0,0">
                            <Button Content="Buscar Actualizaciones" Click="BtnCheckUpdates_Click" DockPanel.Dock="Left" Margin="0,0,12,0" Padding="10,6" />
                            <TextBlock x:Name="TxtUpdates" Text="Sin consultar." VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
<TabItem Header="Instalación">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><Grid x:Name="PipelineActions" MinWidth="570">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tarjeta Principal de Control (One-Click Action) -->
                    <Border Grid.Row="0" Background="#26262B" BorderBrush="#4A4A52" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock x:Name="TxtPipelineStatusTitle" Text="Estado del Pipeline en Cities: Skylines" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextLight}" />
                                <TextBlock x:Name="TxtPipelineStatusSubtitle" Text="Comprobando archivos instalados en la carpeta del juego..." FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Acciones Principales y Preset -->
                            <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Resolución de trabajo NR" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,3" />
                                    <ComboBox x:Name="PresetSelector" AutomationProperties.Name="Resolución de trabajo NR" SelectedIndex="0" Padding="8,6" MinWidth="180">
                                        <ComboBoxItem Content="Trabajo NR 100%" />
                                        <ComboBoxItem Content="Trabajo NR 85%" />
                                        <ComboBoxItem Content="Trabajo NR 66%" />
                                        <ComboBoxItem Content="Trabajo NR 100% · nitidez 0,15" />
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="BtnInstall" Content="Instalar en el Juego" Click="BtnInstall_Click" Background="#27AE60" Padding="18,10" Margin="0,0,8,0" FontWeight="Bold" FontSize="13" VerticalAlignment="Bottom" />
                                <Button x:Name="BtnUninstall" Content="Restaurar / desinstalar" Click="BtnUninstall_Click" Background="#C0392B" Padding="14,10" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Bottom" IsEnabled="False" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Barra de Biblioteca / Preparación de Dependencias -->
                    <Border Grid.Row="1" Background="#202024" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnDownloadAllPublic" Content="⬇️ Descargar Componentes Públicos" Click="BtnDownloadAllPublic_Click" Background="#007ACC" Margin="0,0,8,0" Padding="10,6" />
                                <Button x:Name="BtnAutoDetectDownloads" Content="🔍 Detectar en Descargas" Click="BtnAutoDetectDownloads_Click" Background="#45454B" Margin="0,0,8,0" Padding="10,6" />
                                <Button x:Name="BtnOpenDownloads" Content="📂 Abrir Descargas" Click="BtnOpenDownloads_Click" Background="#45454B" Padding="10,6" />
                            </WrapPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Almacén de Dependencias Locales" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Descarga o importa los runtimes una sola vez. Se conservan listos para instalar o actualizar." FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Encabezados de Tabla de Componentes -->
                    <Grid Grid.Row="2" Margin="14,0,25,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="COMPONENTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}" />
                        <TextBlock Grid.Column="1" Text="EN CITIES: SKYLINES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}" />
                        <TextBlock Grid.Column="2" Text="ALMACÉN LOCAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}" />
                        <TextBlock Grid.Column="3" Text="ACCIÓN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    </Grid>

                    <!-- Lista de Componentes -->
                    <ListBox Grid.Row="3" x:Name="ListDependencies" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,12" BorderBrush="#38383D" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Nombre y Descripción -->
                                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <!-- Estado en el Juego -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding GameFilesDetail}">
                                            <Border Background="{Binding GameStatusBg}" BorderBrush="{Binding GameStatusBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" MinHeight="22" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding GameStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding GameStatusFg}" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding GameStatusDetail}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Estado en Almacén Local -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding CacheStatusText}" FontSize="12" Foreground="{Binding CacheStatusFg}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding StatusMessage}" />
                                            <Button Content="Descargar" Click="BtnDownloadSingle_Click" Tag="{Binding}" Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}" Padding="8,4" Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="11" />
                                        </StackPanel>

                                        <!-- Botones de Acción -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Width="170">
                                            <Button Content="{Binding ImportActionText}" Click="BtnImportDependency_Click" Tag="{Binding}" Visibility="{Binding CanImport, Converter={StaticResource BoolToVis}}" Background="#45454B" Padding="10,6" Margin="0,0,0,4" FontSize="11" ToolTip="Selecciona o arrastra el archivo para incorporarlo al almacén verificado." HorizontalContentAlignment="Center" />
                                            <Button Content="Web Oficial" Click="BtnOpenWebOfficial_Click" Tag="{Binding}" Visibility="{Binding HasOfficialWeb, Converter={StaticResource BoolToVis}}" Background="#333337" Padding="10,5" FontSize="11" HorizontalContentAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer></TabItem>
<TabItem Header="Diagnóstico"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Hardware y Compatibilidad" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />
                        
                        <!-- Tarjeta GPU -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="BadgeGpu" DockPanel.Dock="Right" Background="#333337" Padding="8,4" CornerRadius="4">
                                        <TextBlock x:Name="TxtBadgeGpu" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock x:Name="TxtGpuName" Text="Leyendo adaptador..." FontSize="16" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock x:Name="TxtArchitecture" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta VRAM -->
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Border x:Name="BadgeVram" DockPanel.Dock="Right" Background="#333337" Padding="8,4" CornerRadius="4">
                                    <TextBlock x:Name="TxtBadgeVram" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Memoria de Vídeo Dedicada (VRAM)" Foreground="{StaticResource TextDim}" FontSize="12" />
                                    <TextBlock x:Name="TxtVram" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tarjeta Driver -->
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Border x:Name="BadgeDriver" DockPanel.Dock="Right" Background="#333337" Padding="8,4" CornerRadius="4">
                                    <TextBlock x:Name="TxtBadgeDriver" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Controlador Gráfico" Foreground="{StaticResource TextDim}" FontSize="12" />
                                    <TextBlock x:Name="TxtDriverVer" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    <TextBlock x:Name="TxtDriverRaw" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tarjeta Carpeta del Juego -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ubicación de Cities: Skylines" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                                <DockPanel>
                                    <Button x:Name="BtnBrowseGame" DockPanel.Dock="Right" Content="Elegir Cities.exe" Click="BtnBrowseGame_Click" Margin="10,0,0,0" />
                                    <TextBlock x:Name="TxtGameExe" Text="Buscando instalación de Steam..." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#A9DBF5" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock Text="Permiso de escritura: " Foreground="{StaticResource TextDim}" FontSize="12" />
                                    <TextBlock x:Name="TxtWritePerm" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                    <TextBlock Text="Estado del proceso: " Foreground="{StaticResource TextDim}" FontSize="12" />
                                    <TextBlock x:Name="TxtGameProcess" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Content="Abrir carpeta de Cities: Skylines" Click="BtnOpenGameFolder_Click" HorizontalAlignment="Left" Background="#45454B" Margin="0,4,0,0" Padding="12,6" />
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta Rutas del Mod y Almacén -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Carpetas de NeuralFX" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtAppLocations" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" LineHeight="18" Foreground="{StaticResource TextDim}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Abrir Almacén de Descargas" Click="BtnOpenCache_Click" Background="#45454B" Margin="0,0,8,0" Padding="10,6" />
                                    <Button Content="Abrir Carpeta de Mods de CS1" Click="BtnOpenModFolder_Click" Background="#45454B" Padding="10,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnRefreshDiagnostics" Content="🔄 Volver a Analizar Entorno" Click="BtnRefreshDiagnostics_Click" HorizontalAlignment="Left" Margin="0,4,0,12" />
                    </StackPanel>
                </ScrollViewer>
            <Expander Grid.Row="1" Header="Registros de componentes" Margin="0,8,0,0"><Border Height="260">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="Limpiar consola" Click="BtnClearLog_Click" DockPanel.Dock="Right" Padding="10,5" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RadioLogHub" Content="Registro del Hub" GroupName="LogSource" IsChecked="True" Checked="RadioLog_Checked" Margin="0,0,20,0" Foreground="White" />
                            <RadioButton x:Name="RadioLogReShade" Content="ReShade.log" GroupName="LogSource" Checked="RadioLog_Checked" Margin="0,0,20,0" Foreground="White" />
                            <RadioButton x:Name="RadioLogFeeder" Content="dlss5-feed.log" GroupName="LogSource" Checked="RadioLog_Checked" Foreground="White" />
                        </StackPanel>
                    </DockPanel>
                    <TextBox Grid.Row="1" x:Name="TxtLogConsole" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#141416" Foreground="#D4D4D4" BorderBrush="#333337" Padding="10" />
                </Grid>
            </Border></Expander></Grid></TabItem>
        </TabControl>

        <!-- Barra Inferior -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="En el juego: Presiona Ctrl + Alt + N para el panel in-game · Tecla Home para el menú ReShade" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
