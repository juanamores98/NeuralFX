<Window x:Class="NeuralFX.Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuralFX Hub · Cities: Skylines 1" Width="1000" Height="700" MinWidth="720" MinHeight="460"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RailItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="RailSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2,0,0,0" Padding="20,9">
                            <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RailSurface" Property="Background" Value="#212123" />
                                <Setter Property="Foreground" Value="{StaticResource TextLight}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RailSurface" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="RailSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextLight}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RailSurface" Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Rail" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BgDark}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="22,26,22,24">
                                        <TextBlock Text="NEURALFX" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding HubVersion}"
                                                   Style="{StaticResource SectionLabel}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,20">
                                        <TextBlock Text="Panel en ciudad" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="Ctrl + Alt + N" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource TextDim}" Margin="0,2,0,10" />
                                        <TextBlock Text="Menú ReShade" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="Home" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TabPanel IsItemsHost="True" VerticalAlignment="Top" />
                                </DockPanel>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Aviso de operación: visible hasta la siguiente operación o hasta cerrar -->
        <Border Grid.Row="0" x:Name="OperationNotice" Background="#1C3445" BorderBrush="#497D9C"
                BorderThickness="0,0,0,1" Padding="24,12" Visibility="Collapsed">
            <DockPanel>
                <Button Content="Ver registro" Click="BtnShowLogs_Click" DockPanel.Dock="Right"
                        Margin="16,0,0,0" VerticalAlignment="Center" Padding="12,6" FontSize="12" />
                <StackPanel>
                    <TextBlock x:Name="TxtOperationTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtOperationDetail" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12"
                               Foreground="{StaticResource TextDim}" />
                    <ProgressBar x:Name="OperationProgress" IsIndeterminate="True" Height="2" Margin="0,9,0,0"
                                 Background="Transparent" Foreground="{StaticResource Accent}" BorderThickness="0"
                                 Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="0" TabStripPlacement="Left"
                    Style="{StaticResource Rail}" ItemContainerStyle="{StaticResource RailItem}">

            <!-- ESTADO -->
            <TabItem Header="Estado">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <Grid Margin="36,34,50,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PillSession" Width="8" Height="8" CornerRadius="4"
                                        Background="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock x:Name="TxtSessionSummary" Text="Sin sesión activa" FontSize="24"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="TxtSessionHint" Text="Abre Cities: Skylines para recibir métricas."
                                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap" MaxWidth="640"
                                       HorizontalAlignment="Left" Margin="20,8,0,0" LineHeight="20" />
                        </StackPanel>

                        <!-- Métricas vivas -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Margin="0,28,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,16,18,16">
                                    <TextBlock Text="FPS" Style="{StaticResource SectionLabel}" />
                                    <TextBlock x:Name="TxtMetricFps" Text="—" Style="{StaticResource Metric}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,16,18,16">
                                    <TextBlock Text="Intervalo" Style="{StaticResource SectionLabel}" />
                                    <TextBlock x:Name="TxtMetricFrame" Text="—" Style="{StaticResource Metric}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="18,16,18,16">
                                    <TextBlock Text="Trabajo NR" Style="{StaticResource SectionLabel}" />
                                    <TextBlock x:Name="TxtMetricWork" Text="—" Style="{StaticResource Metric}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="18,16,0,16">
                                    <TextBlock Text="Reset conf. / solic." Style="{StaticResource SectionLabel}" />
                                    <TextBlock x:Name="TxtMetricReset" Text="—" Style="{StaticResource Metric}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Controles de sesión -->
                        <StackPanel Grid.Row="2" x:Name="TelemetryCommands" IsEnabled="False" Margin="0,26,0,0">
                            <WrapPanel>
                                <Button x:Name="BtnPipelineToggle" Content="Activar NeuralFX" Tag="EnablePipeline"
                                        Click="BtnTelemetryCommand_Click" Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,12,10" />
                                <Button Content="Reset de historial" Tag="ResetHistory" Click="BtnTelemetryCommand_Click"
                                        Margin="0,0,12,10" />
                                <Button Content="Abrir panel en ciudad" Tag="TogglePanel" Click="BtnTelemetryCommand_Click"
                                        Margin="0,0,12,10" />
                                <Button Content="Reaplicar buffers" Tag="ReapplyBuffers" Click="BtnTelemetryCommand_Click"
                                        Margin="0,0,0,10" />
                            </WrapPanel>

                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,32,10">
                                    <TextBlock Text="Trabajo NR" Foreground="{StaticResource TextDim}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ListBox x:Name="SessionWorkSelector" Style="{StaticResource Segmented}" SelectedIndex="0"
                                             AutomationProperties.Name="Trabajo NR de la sesión"
                                             SelectionChanged="SessionControl_SelectionChanged" Tag="SetWorkResolution">
                                        <ListBoxItem Content="100%" />
                                        <ListBoxItem Content="85%" />
                                        <ListBoxItem Content="66%" />
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Nitidez" Foreground="{StaticResource TextDim}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ListBox x:Name="SessionSharpSelector" Style="{StaticResource Segmented}" SelectedIndex="2"
                                             AutomationProperties.Name="Nitidez de la sesión"
                                             SelectionChanged="SessionControl_SelectionChanged" Tag="SetSharpness">
                                        <ListBoxItem Content="Apagada" />
                                        <ListBoxItem Content="0,15" />
                                        <ListBoxItem Content="0,30" />
                                    </ListBox>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Text="El trabajo NR reduce el coste del addon, no la resolución que renderiza Unity. NR consume GPU: no está pensado para subir los FPS de una ciudad limitada por CPU."
                                       Style="{StaticResource SectionLabel}" TextWrapping="Wrap" MaxWidth="660"
                                       HorizontalAlignment="Left" LineHeight="18" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Detalle -->
                        <StackPanel Grid.Row="3" Margin="0,30,0,0">
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <DockPanel>
                                    <Button Content="Buscar actualizaciones" Click="BtnCheckUpdates_Click"
                                            DockPanel.Dock="Right" Style="{StaticResource LinkButton}" />
                                    <TextBlock Text="Detalles de la sesión" Foreground="{StaticResource TextDim}" FontSize="12" />
                                </DockPanel>
                            </Border>
                            <TextBlock x:Name="TxtTelemetry" Text="Esperando conexión del mod en ciudad…"
                                       FontFamily="Consolas" FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDim}" Margin="0,12,0,0" />
                            <TextBlock x:Name="TxtUpdates" Text="Sin consultar." Style="{StaticResource SectionLabel}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- INSTALAR -->
            <TabItem Header="Instalar">
                <Grid x:Name="PipelineActions" Margin="36,34,36,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                      <StackPanel Margin="0,0,14,0">

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border x:Name="PillGameStatus" Width="8" Height="8" CornerRadius="4"
                                    Background="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtGameStatus" Text="VERIFICANDO…" FontSize="11"
                                       Foreground="{StaticResource TextDim}" />
                        </StackPanel>
                        <TextBlock x:Name="TxtPipelineStatusTitle" Text="Comprobando archivos del juego…"
                                   FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtPipelineStatusSubtitle"
                                   Text="Leyendo el registro de instalación en la carpeta de Cities: Skylines."
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap" MaxWidth="620"
                                   HorizontalAlignment="Left" Margin="0,8,0,0" LineHeight="20" />
                    </StackPanel>

                    <!-- Preset -->
                    <StackPanel Margin="0,28,0,0">
                        <TextBlock Text="Preset" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,10" />
                        <ListBox x:Name="PresetSelector" SelectedIndex="0" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="Preset del pipeline"
                                 ItemContainerStyle="{StaticResource PresetCard}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem>
                                <StackPanel>
                                    <TextBlock Text="Nativo" FontWeight="SemiBold" />
                                    <TextBlock Text="Trabajo 100% · CAS 0,30" Style="{StaticResource SectionLabel}" Margin="0,5,0,0" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel>
                                    <TextBlock Text="Equilibrado" FontWeight="SemiBold" />
                                    <TextBlock Text="Trabajo 85% · CAS 0,30" Style="{StaticResource SectionLabel}" Margin="0,5,0,0" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel>
                                    <TextBlock Text="Coste reducido" FontWeight="SemiBold" />
                                    <TextBlock Text="Trabajo 66% · CAS 0,30" Style="{StaticResource SectionLabel}" Margin="0,5,0,0" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel>
                                    <TextBlock Text="Fotografía" FontWeight="SemiBold" />
                                    <TextBlock Text="Trabajo 100% · CAS 0,15" Style="{StaticResource SectionLabel}" Margin="0,5,0,0" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>

                    <!-- Acción primaria -->
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button x:Name="BtnInstall" Content="Instalar en el juego" Click="BtnInstall_Click"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtInstallHint" Text="El juego debe estar cerrado mientras se escriben los archivos."
                                   Style="{StaticResource SectionLabel}" TextWrapping="Wrap" MaxWidth="300"
                                   VerticalAlignment="Center" Margin="16,0,0,0" LineHeight="17" />
                        <!-- Abrir o cerrar CS1 sin salir del Hub: ReShade no se puede escribir con el juego abierto -->
                        <Button x:Name="BtnGameProcess" Content="Abrir Cities: Skylines" Click="BtnGameProcess_Click"
                                Margin="16,0,0,0" Padding="12,6" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Componentes: una línea, con el detalle plegado -->
                    <Expander x:Name="ComponentsExpander" Margin="0,30,0,0">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtComponentsSummary" Text="Componentes"
                                           Foreground="{StaticResource TextLight}" FontSize="13" />
                            </StackPanel>
                        </Expander.Header>
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button x:Name="BtnDownloadAllPublic" Content="Descargar componentes públicos"
                                        Click="BtnDownloadAllPublic_Click" Margin="0,0,8,6" Padding="12,6" FontSize="12" />
                                <Button x:Name="BtnAutoDetectDownloads" Content="Detectar en Descargas"
                                        Click="BtnAutoDetectDownloads_Click" Margin="0,0,8,6" Padding="12,6" FontSize="12" />
                                <Button x:Name="BtnOpenDownloads" Content="Abrir Descargas" Click="BtnOpenDownloads_Click"
                                        Margin="0,0,0,6" Padding="12,6" FontSize="12" />
                            </WrapPanel>
                            <ListBox Grid.Row="1" x:Name="ListDependencies" Background="Transparent"
                                     BorderBrush="{StaticResource Line}" BorderThickness="1" MaxHeight="640"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding CacheStatusText}" DockPanel.Dock="Right"
                                                               Foreground="{Binding CacheStatusFg}" FontSize="11"
                                                               ToolTip="{Binding StatusMessage}" Margin="12,0,0,0" />
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <StackPanel Margin="0,5,0,0" ToolTip="{Binding GameFilesDetail}">
                                                    <TextBlock Text="{Binding GameStatusText}" Foreground="{Binding GameStatusFg}"
                                                               FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding GameStatusDetail}" TextWrapping="Wrap"
                                                               Style="{StaticResource SectionLabel}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <WrapPanel Margin="0,9,0,0">
                                                    <Button Content="Descargar" Click="BtnDownloadSingle_Click" Tag="{Binding}"
                                                            Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                                                            Margin="0,0,8,0" Padding="10,4" FontSize="12" />
                                                    <Button Content="{Binding ImportActionText}" Click="BtnImportDependency_Click" Tag="{Binding}"
                                                            Visibility="{Binding CanImport, Converter={StaticResource BoolToVis}}"
                                                            Margin="0,0,8,0" Padding="10,4" FontSize="12" />
                                                    <Button Content="Procedencia" Click="BtnOpenWebOfficial_Click" Tag="{Binding}"
                                                            Visibility="{Binding HasOfficialWeb, Converter={StaticResource BoolToVis}}"
                                                            Style="{StaticResource LinkButton}" Margin="0,0,8,0" />
                                                </WrapPanel>
                                                <!-- Detalle de referencia: plegado, para que la lista quepa entera -->
                                                <Expander Margin="0,6,0,0">
                                                    <Expander.Header>
                                                        <TextBlock Text="Versión y procedencia" Style="{StaticResource SectionLabel}" />
                                                    </Expander.Header>
                                                    <TextBlock Text="{Binding ProvenanceDescription}" Style="{StaticResource SectionLabel}"
                                                               TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17" />
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Expander>

                      </StackPanel>
                    </ScrollViewer>

                    <!-- Acciones poco frecuentes, al pie -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Restaurar estado anterior…" Click="BtnRestore_Click"
                                    Style="{StaticResource LinkButton}" Margin="0,0,24,0" />
                            <Button x:Name="BtnUninstall" Content="Desinstalar del juego…" Click="BtnUninstall_Click"
                                    Style="{StaticResource LinkButton}" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SISTEMA -->
            <TabItem Header="Sistema">
                <Grid Margin="36,34,36,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Sistema" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtArchitecture" TextWrapping="Wrap" MaxWidth="620"
                                       HorizontalAlignment="Left" Foreground="{StaticResource TextDim}"
                                       Margin="0,8,0,0" LineHeight="20" />

                            <Grid Margin="0,26,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Adaptador" Style="{StaticResource SectionLabel}" Margin="0,11,24,11" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,11,0,11">
                                    <TextBlock x:Name="TxtGpuName" Text="Leyendo adaptador…" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtBadgeGpu" Foreground="{StaticResource Accent}" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>

                                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="VRAM dedicada" Style="{StaticResource SectionLabel}" Margin="0,11,24,11" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,11,0,11">
                                    <TextBlock x:Name="TxtVram" />
                                    <TextBlock x:Name="TxtBadgeVram" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>

                                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Controlador" Style="{StaticResource SectionLabel}" Margin="0,11,24,11" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,11,0,11">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtDriverVer" />
                                        <TextBlock x:Name="TxtBadgeDriver" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtDriverRaw" Style="{StaticResource SectionLabel}" Margin="0,3,0,0" />
                                </StackPanel>

                                <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cities.exe" Style="{StaticResource SectionLabel}" Margin="0,11,24,11" />
                                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,8">
                                    <Button x:Name="BtnBrowseGame" DockPanel.Dock="Right" Content="Elegir Cities.exe"
                                            Click="BtnBrowseGame_Click" Margin="12,0,0,0" Padding="12,5" FontSize="12" />
                                    <TextBlock x:Name="TxtGameExe" Text="Buscando instalación de Steam…" TextWrapping="Wrap"
                                               FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextDim}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Permiso de escritura" Style="{StaticResource SectionLabel}" Margin="0,11,24,11" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtWritePerm" Margin="0,11,0,11" TextWrapping="Wrap" />

                                <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Proceso del juego" Style="{StaticResource SectionLabel}" Margin="0,11,24,11" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtGameProcess" Margin="0,11,0,11" TextWrapping="Wrap" />

                                <Border Grid.Row="6" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Carpetas de NeuralFX" Style="{StaticResource SectionLabel}" Margin="0,11,24,11" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtAppLocations" TextWrapping="Wrap"
                                           FontSize="12" LineHeight="19" Foreground="{StaticResource TextDim}" Margin="0,11,0,11" />

                                <Border Grid.Row="7" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Integridad de archivos" Style="{StaticResource SectionLabel}" Margin="0,11,24,11" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtIntegrity" Text="Comprobando archivos…"
                                           TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                           Foreground="{StaticResource TextDim}" Margin="0,11,0,11" />
                            </Grid>

                            <WrapPanel Margin="0,20,0,0">
                                <Button x:Name="BtnRefreshDiagnostics" Content="Volver a analizar" Click="BtnRefreshDiagnostics_Click"
                                        Margin="0,0,8,8" Padding="12,6" FontSize="12" />
                                <Button Content="Abrir carpeta del juego" Click="BtnOpenGameFolder_Click" Margin="0,0,8,8" Padding="12,6" FontSize="12" />
                                <Button Content="Abrir almacén local" Click="BtnOpenCache_Click" Margin="0,0,8,8" Padding="12,6" FontSize="12" />
                                <Button Content="Abrir carpeta de mods" Click="BtnOpenModFolder_Click" Margin="0,0,0,8" Padding="12,6" FontSize="12" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Expander Grid.Row="1" Margin="0,14,0,0">
                        <Expander.Header><TextBlock Text="Registros" Foreground="{StaticResource TextLight}" FontSize="13" /></Expander.Header>
                        <Grid Height="240" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <Button Content="Limpiar" Click="BtnClearLog_Click" DockPanel.Dock="Right"
                                        Style="{StaticResource LinkButton}" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadioLogHub" Content="Hub" GroupName="LogSource" IsChecked="True"
                                                 Checked="RadioLog_Checked" Margin="0,0,4,0" />
                                    <RadioButton x:Name="RadioLogReShade" Content="ReShade.log" GroupName="LogSource"
                                                 Checked="RadioLog_Checked" Margin="0,0,4,0" />
                                    <RadioButton x:Name="RadioLogFeeder" Content="dlss5-feed.log" GroupName="LogSource"
                                                 Checked="RadioLog_Checked" />
                                </StackPanel>
                            </DockPanel>
                            <TextBox Grid.Row="1" x:Name="TxtLogConsole" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#161618"
                                     Foreground="#D8D8DC" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" />
                        </Grid>
                    </Expander>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
