<Window x:Class="NeuralFX.Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuralFX Hub - Diagnóstico e Inyección DLSS 5 / ReShade" 
        Height="720" Width="1040"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NEURALFX" FontWeight="Bold" FontSize="20" Foreground="{StaticResource Success}" />
                        <TextBlock Text=" HUB" FontWeight="Light" FontSize="20" Foreground="{StaticResource TextLight}" />
                        <Border Background="#334EC9B0" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Suite Autónoma de Diagnóstico, Escalado Neural e Inyección Atómica para Cities: Skylines 1" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Status Pill -->
                <Border Grid.Column="1" x:Name="PillGameStatus" Background="#264E26" BorderBrush="{StaticResource Success}" BorderThickness="1" CornerRadius="14" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtGameStatus" Text="ESTADO: VANILLA LIMPIO" FontWeight="Bold" FontSize="12" Foreground="White" />
                </Border>
            </Grid>
        </Border>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#252526" />
                    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,10" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="4,4,0,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2D2D30" />
                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Diagnóstico de Hardware -->
            <TabItem Header=" Diagnóstico de Hardware &amp; Sistema ">
                <Border Background="#2D2D30" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="0,4,4,4" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Resultados del Análisis de Entorno y Compatibilidad" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />

                            <!-- GPU Card -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="GPU Principal:" FontWeight="SemiBold" FontSize="13" Width="140" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtGpuName" Text="Cargando..." FontWeight="Bold" FontSize="14" Foreground="{StaticResource Success}" />
                                        <TextBlock x:Name="TxtArchitecture" Text="Arquitectura..." FontSize="12" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BadgeGpu" Background="#264E26" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBadgeGpu" Text="COMPATIBLE" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- VRAM Card -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Memoria de Video:" FontWeight="SemiBold" FontSize="13" Width="140" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtVram" Text="Cargando..." FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="Lectura 64-bit directa de Registro (sin desbordamiento de 4GB WMI)" FontSize="11" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BadgeVram" Background="#264E26" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBadgeVram" Text="&gt; 8 GB (ÓPTIMO)" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Driver Card -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Driver de NVIDIA:" FontWeight="SemiBold" FontSize="13" Width="140" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDriverVer" Text="Cargando..." FontWeight="Bold" FontSize="14" />
                                        <TextBlock x:Name="TxtDriverRaw" Text="Raw Windows: ..." FontSize="11" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BadgeDriver" Background="#264E26" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBadgeDriver" Text="&gt;= 570.xx (CUMPLE)" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Cities Skylines Card -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Cities: Skylines 1:" FontWeight="SemiBold" FontSize="13" Width="140" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtGameExe" Text="Buscando..." FontWeight="Medium" FontSize="12" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBrowseGame" Content="Examinar..." Click="BtnBrowseGame_Click" Padding="10,4" FontSize="11" />

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Permiso de escritura en carpeta: " FontSize="11" Foreground="{StaticResource TextDim}" />
                                        <TextBlock x:Name="TxtWritePerm" Text="Comprobando..." FontWeight="Bold" FontSize="11" Foreground="{StaticResource Success}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Action bar -->
                            <Button x:Name="BtnRefreshDiagnostics" Content="Re-analizar Hardware y Entorno" Click="BtnRefreshDiagnostics_Click" HorizontalAlignment="Left" Padding="16,8" Background="#0E639C" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 2: Dependencias & Pipeline -->
            <TabItem Header=" Dependencias &amp; Inyección ">
                <Border Background="#2D2D30" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="0,4,4,4" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Gestión Segura de Componentes &amp; Binarios Propietarios" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="Los binarios propietarios de NVIDIA (nvngx_dlss / nvngx_dlssnr) no se descargan de enlaces caducos; se importan con validación de integridad SHA-256." FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Dependencies ItemsControl / List -->
                        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
                            <ListBox x:Name="ListDependencies" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextLight}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding TargetRelativePath, StringFormat='Destino: {0}'}" FontSize="10" Foreground="#888888" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#333337" CornerRadius="3" Padding="8,4" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                                                </Border>
                                                <Button Grid.Column="2" Content="Importar DLL..." Tag="{Binding}" Click="BtnImportDependency_Click" Padding="10,4" FontSize="11" VerticalAlignment="Center" Visibility="{Binding SourceType, Converter={x:Null}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Action buttons bottom -->
                        <Border Grid.Row="2" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="La inyección registra un manifiesto completo. El Rollback restaura el juego a vanilla de manera 100% limpia sin tocar configuraciones del usuario." FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                                <Button Grid.Column="1" x:Name="BtnRollback" Content="Desinstalar y Rollback Limpio (Zero-Trace)" Click="BtnRollback_Click" Background="{StaticResource Danger}" Margin="0,0,10,0" />
                                <Button Grid.Column="2" x:Name="BtnInstall" Content="Instalar / Inyectar Pipeline DLSS 5" Click="BtnInstall_Click" Background="{StaticResource Accent}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 3: Telemetría & Logs en Vivo -->
            <TabItem Header=" Telemetría &amp; Logs en Vivo ">
                <Border Background="#2D2D30" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="0,4,4,4" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Controls -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="RadioLogHub" Content="Log del Hub" IsChecked="True" Checked="RadioLog_Checked" Foreground="{StaticResource TextLight}" Margin="0,0,14,0" />
                                <RadioButton x:Name="RadioLogReShade" Content="ReShade.log" Checked="RadioLog_Checked" Foreground="{StaticResource TextLight}" Margin="0,0,14,0" />
                                <RadioButton x:Name="RadioLogFeeder" Content="dlss5-feed.log" Checked="RadioLog_Checked" Foreground="{StaticResource TextLight}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="Limpiar Log" Click="BtnClearLog_Click" Padding="10,4" FontSize="11" Margin="0,0,8,0" Background="#3E3E42" />
                            <Button Grid.Column="3" Content="Abrir Carpeta del Juego" Click="BtnOpenGameFolder_Click" Padding="10,4" FontSize="11" Background="#3E3E42" />
                        </Grid>

                        <!-- Log Console -->
                        <Border Grid.Row="1" Background="#0C0C0C" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <TextBox x:Name="TxtLogConsole" Background="Transparent" Foreground="#DCDCDC" BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                        </Border>

                        <TextBlock Grid.Row="2" Text="Consejo in-game: Dentro de Cities: Skylines presiona Ctrl + Alt + N para abrir el panel de telemetría de NeuralFX Mod, y presiona Home para ReShade." FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,8,0,0" />
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
