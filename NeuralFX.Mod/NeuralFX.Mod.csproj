<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>NeuralFX</AssemblyName>
    <Version>2.1.1</Version>
    <RootNamespace>NeuralFX</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>False</AutoGenerateBindingRedirects>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AnalysisLevel>none</AnalysisLevel>

    <ManagedDLLPath Condition="'$(ManagedDLLPath)' == ''">$(MSBuildProgramFiles32)/Steam/steamapps/common/Cities_Skylines/Cities_Data/Managed</ManagedDLLPath>
    <AssemblySearchPaths>
      $(AssemblySearchPaths);
      $(ManagedDLLPath)
    </AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Protocol\%(Filename)%(Extension)" />
    <Reference Include="Assembly-CSharp" />
    <Reference Include="ColossalManaged" />
    <Reference Include="ICities" />
    <Reference Include="UnityEngine" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!--
    Despliegue en caliente del mod administrado, como el resto de mods del workspace.
    Copia SOLO NeuralFX.dll y SOLO a Addons/Mods/NeuralFX: CS1 escanea recursivamente
    todas las DLL de esa carpeta e intenta cargarlas como ensamblados del juego, así que
    el Hub de escritorio nunca puede vivir ahí.

    Esto no sustituye a `tools/package.ps1 -Deploy`, que es la entrega real: mod, Hub y
    addon nativo juntos, con hashes, manifiesto y copias de seguridad. Desplegar solo el
    mod puede dejarlo por delante del puente instalado; si los contratos no coinciden el
    mod entra en bypass y lo dice en su estado, no rompe la partida.

      -p:DeployMod=false   no copiar en esta compilación
      -p:SkipDeploy=true   igual, y es lo que ya usan los scripts de empaquetado
      -p:ModDeployDir=…    otra carpeta de destino
  -->
  <PropertyGroup>
    <DeployMod Condition="'$(DeployMod)' == ''">true</DeployMod>
    <ModDeployDir Condition="'$(ModDeployDir)' == ''">$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Addons\Mods\NeuralFX\</ModDeployDir>
  </PropertyGroup>

  <Target Name="DeployToModDirectory" AfterTargets="Build"
          Condition="'$(DeployMod)' == 'true' and '$(SkipDeploy)' != 'true' and '$(OS)' == 'Windows_NT'">
    <MakeDir Directories="$(ModDeployDir)" ContinueOnError="WarnAndContinue" />
    <!-- Un reintento corto: con CS1 abierto el archivo está bloqueado y no se desbloquea esperando. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)" Retries="1" RetryDelayMilliseconds="250" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="_DeployedMod" />
    </Copy>
    <Warning Condition="'@(_DeployedMod)' == ''"
             Text="No se pudo copiar NeuralFX.dll a $(ModDeployDir). Si Cities: Skylines está abierto mantiene el archivo bloqueado: ciérralo y vuelve a compilar." />
    <Message Condition="'@(_DeployedMod)' != ''" Importance="high"
             Text="NeuralFX.dll desplegado en $(ModDeployDir) · actívalo en el Gestor de contenido. El Hub y el addon nativo se actualizan aparte con tools/package.ps1 -Deploy." />
  </Target>

</Project>
