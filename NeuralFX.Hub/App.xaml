<Application x:Class="NeuralFX.Hub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark Theme Global Colors -->
        <Color x:Key="BgDarkColor">#1E1E1E</Color>
        <Color x:Key="CardBgColor">#252526</Color>
        <Color x:Key="CardBorderColor">#3E3E42</Color>
        <Color x:Key="AccentColor">#007ACC</Color>
        <Color x:Key="AccentHoverColor">#1C97EA</Color>
        <Color x:Key="SuccessColor">#4EC9B0</Color>
        <Color x:Key="WarningColor">#CE9178</Color>
        <Color x:Key="DangerColor">#F44747</Color>
        <Color x:Key="TextLightColor">#F1F1F1</Color>
        <Color x:Key="TextDimColor">#9D9D9D</Color>

        <SolidColorBrush x:Key="BgDark" Color="{StaticResource BgDarkColor}" />
        <SolidColorBrush x:Key="CardBg" Color="{StaticResource CardBgColor}" />
        <SolidColorBrush x:Key="CardBorder" Color="{StaticResource CardBorderColor}" />
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
        <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="TextLight" Color="{StaticResource TextLightColor}" />
        <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLight}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#A9DBF5" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Background" Value="#3E3E42" />
                    <Setter Property="Foreground" Value="#888888" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
