<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeuralFX.Hub\NeuralFX.Hub.csproj" />
    <ProjectReference Include="..\NeuralFX.ProcessFixture\NeuralFX.ProcessFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyProcessFixture" AfterTargets="Build">
    <ItemGroup><_FixtureFiles Include="../NeuralFX.ProcessFixture/bin/$(Configuration)/net8.0-windows/*" /></ItemGroup>
    <Copy SourceFiles="@(_FixtureFiles)" DestinationFolder="$(OutDir)ProcessFixture" />
  </Target>

</Project>
